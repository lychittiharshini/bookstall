rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Settings
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Stationery Categories & Products
    match /stationery_categories/{categoryId} {
      allow read, write: if true;
    }

    match /stationery_products/{productId} {
      allow read, write: if true;
    }

    // Fancy Categories & Products
    match /fancy_categories/{categoryId} {
      allow read, write: if true;
    }

    match /fancy_products/{productId} {
      allow read, write: if true;
    }

    // Xerox & Printing Services
    match /xerox_services/{serviceId} {
      allow read, write: if true;
    }

    // Gallery Photographs
    match /gallery/{galleryId} {
      allow read, write: if true;
    }

    // Promotional Offers
    match /offers/{offerId} {
      allow read, write: if true;
    }

    // Customer & Shop Orders
    match /orders/{orderDocId} {
      allow read, write: if true;
    }

    // Connection testing
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
